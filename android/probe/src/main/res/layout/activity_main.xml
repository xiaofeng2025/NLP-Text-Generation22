<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:baselineAligned="false"
    android:orientation="horizontal"
    android:padding="16dp">

    <!-- Left: the report. Focusable so the D-pad can scroll it. -->
    <ScrollView
        android:id="@+id/reportScroll"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="12dp"
        android:layout_weight="3"
        android:background="@drawable/panel_bg"
        android:fillViewport="true"
        android:focusable="true"
        android:nextFocusRight="@+id/btnCamera2"
        android:padding="12dp">

        <TextView
            android:id="@+id/reportText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="2dp"
            android:textColor="#E8EEF4"
            android:textSize="14sp" />
    </ScrollView>

    <!-- Right: live preview, status line, buttons. -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="2"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/previewBox"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#000000" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minLines="4"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="@string/status_idle"
            android:textColor="#FFD54F"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnCamera2"
                style="@style/ProbeButton"
                android:nextFocusLeft="@id/reportScroll"
                android:text="@string/btn_camera2" />

            <Button
                android:id="@+id/btnUvc"
                style="@style/ProbeButton"
                android:text="@string/btn_uvc" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnAudio"
                style="@style/ProbeButton"
                android:nextFocusLeft="@id/reportScroll"
                android:text="@string/btn_audio" />

            <Button
                android:id="@+id/btnStop"
                style="@style/ProbeButton"
                android:text="@string/btn_stop" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnScan"
                style="@style/ProbeButton"
                android:nextFocusLeft="@id/reportScroll"
                android:text="@string/btn_scan" />

            <Button
                android:id="@+id/btnSave"
                style="@style/ProbeButton"
                android:text="@string/btn_save" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
